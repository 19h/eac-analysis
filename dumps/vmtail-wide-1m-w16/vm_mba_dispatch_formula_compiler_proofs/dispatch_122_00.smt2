(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (not (= (bvand (bvadd (bvadd u16_0 (bvadd state0 flags0)) #x1af9be18) #x0000ffff) (bvand (bvand (bvadd (bvadd #x1af9be18 (bvadd flags0 state0)) u16_0) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

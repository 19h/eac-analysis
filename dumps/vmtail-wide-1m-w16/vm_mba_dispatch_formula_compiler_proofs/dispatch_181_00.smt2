(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_4 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_4) #x0000))
(assert (not (= (bvand (bvsub u16_4 state0) #x0000ffff) (bvand (bvand (bvsub u16_4 state0) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

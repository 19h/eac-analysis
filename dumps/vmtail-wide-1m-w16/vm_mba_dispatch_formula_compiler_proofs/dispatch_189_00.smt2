(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvand (bvxor (bvadd u16_2 (bvand state0 #x160e4f34)) #x2a1ce984) #x0000ffff) (bvand (bvand (bvxor (bvadd (bvand state0 #x160e4f34) u16_2) #x2a1ce984) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

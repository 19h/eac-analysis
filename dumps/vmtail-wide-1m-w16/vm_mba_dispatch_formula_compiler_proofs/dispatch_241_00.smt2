(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_11 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_11) #x0000))
(assert (not (= (bvand (bvadd u16_11 state0) #x0000ffff) (bvand (bvand (bvadd state0 u16_11) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

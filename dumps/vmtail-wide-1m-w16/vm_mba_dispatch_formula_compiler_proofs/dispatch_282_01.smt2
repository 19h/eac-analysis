(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvand (bvxor (bvsub u16_2 (bvxor state0 (bvsub flags0 #x334721c0))) #x644d2bc4) #x0000ffff) (bvxor (bvsub u16_2 (bvxor (bvadd #xccb8de40 flags0) state0)) #x644d2bc4))))
(check-sat)
(get-model)

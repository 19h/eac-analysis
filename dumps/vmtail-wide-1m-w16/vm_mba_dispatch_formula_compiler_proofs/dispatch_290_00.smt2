(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvand (bvxor (bvadd u16_2 (bvor state0 (bvand flags0 #x3acb356d))) #x29d9517b) #x0000ffff) (bvand (bvand (bvxor (bvadd (bvor (bvand flags0 #x3acb356d) state0) u16_2) #x29d9517b) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvand (bvsub u16_3 (bvsub (bvsub (bvand state0 flags0) flags0) #x7e143884)) #x0000ffff) (bvand (bvand (bvsub (bvadd (bvadd #x7e143884 u16_3) flags0) (bvand flags0 state0)) #x0000ffff) #x0000ffff))))
(check-sat)
(get-model)

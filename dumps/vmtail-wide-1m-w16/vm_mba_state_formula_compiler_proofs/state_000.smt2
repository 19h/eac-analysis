(assert (not (= (bvxor (bvxor state0 (bvadd (bvsub #x1966e0e7 u16_0) state0)) (bvsub #x1966e0e7 #x251a0141)) (bvxor (bvxor (bvsub (bvadd #x1966e0e7 state0) u16_0) state0) #xf44cdfa6))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (not (= (bvor (bvsub (bvadd (bvsub state0 flags0) #x0504fc3d) #x4eca0e49) (bvxor (bvxor u16_0 (bvsub (bvadd (bvsub state0 flags0) #x0504fc3d) #x4eca0e49)) #x384e1c86)) (bvor (bvxor (bvxor u16_0 (bvsub (bvadd #xb63aedf4 state0) flags0)) #x384e1c86) (bvsub (bvadd #xb63aedf4 state0) flags0)))))
(check-sat)
(get-model)

(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvor (bvor state0 (bvxor (bvxor (bvxor u16_2 (bvadd flags0 #x0d90ded5)) (bvadd #x5dbb6647 u16_0)) state0)) (bvxor (bvxor u16_2 (bvadd flags0 #x0d90ded5)) (bvadd #x5dbb6647 #x7ebb48a2))) (bvor (bvor (bvxor (bvadd u16_0 #x5dbb6647) (bvxor (bvadd #x0d90ded5 flags0) u16_2)) (bvxor (bvxor (bvadd #x0d90ded5 flags0) u16_2) #xdc76aee9)) state0))))
(check-sat)
(get-model)

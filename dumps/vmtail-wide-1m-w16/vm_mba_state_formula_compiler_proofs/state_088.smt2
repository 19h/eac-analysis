(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_1 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_1) #x0000))
(assert (not (= (bvor (bvor state0 (bvxor (bvsub flags0 #x1c9cfcea) (bvadd u16_1 state0))) (bvxor (bvsub flags0 #x1c9cfcea) #x415462f5)) (bvor (bvor (bvxor (bvadd u16_1 state0) (bvadd #xe3630316 flags0)) (bvxor (bvadd #xe3630316 flags0) #x415462f5)) state0))))
(check-sat)
(get-model)

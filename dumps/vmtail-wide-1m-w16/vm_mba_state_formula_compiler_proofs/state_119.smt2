(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_4 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_4) #x0000))
(assert (not (= (bvor state0 (bvxor u16_4 (bvadd state0 #x7e7974a5))) (bvor (bvxor (bvadd #x7e7974a5 state0) u16_4) state0))))
(check-sat)
(get-model)

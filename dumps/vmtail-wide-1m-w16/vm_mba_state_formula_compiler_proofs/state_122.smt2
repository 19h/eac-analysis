(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (not (= (bvadd (bvadd (bvadd (bvsub (bvadd state0 flags0) u16_0) state0) flags0) #x1af9be18) (bvadd (bvsub #x1af9be18 u16_0) (bvmul (bvadd flags0 state0) #x00000002)))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvxor (bvadd state0 flags0) (bvadd (bvadd (bvadd u16_3 state0) flags0) #x77236c60)) (bvxor (bvadd (bvadd #x77236c60 (bvadd flags0 state0)) u16_3) (bvadd flags0 state0)))))
(check-sat)
(get-model)

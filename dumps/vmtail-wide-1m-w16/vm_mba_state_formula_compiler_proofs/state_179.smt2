(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_1 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_1) #x0000))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvor (bvor state0 (bvxor (bvxor (bvxor flags0 u16_3) (bvadd flags0 #x7ef33dc5)) (bvsub u16_1 state0))) (bvxor (bvxor flags0 u16_3) (bvsub (bvadd flags0 #x7ef33dc5) #x263c3887))) (bvor (bvxor (bvxor (bvadd #x7ef33dc5 flags0) (bvxor u16_3 flags0)) (bvsub u16_1 state0)) (bvor (bvxor (bvadd flags0 #x58b7053e) (bvxor u16_3 flags0)) state0)))))
(check-sat)
(get-model)

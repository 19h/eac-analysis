(assert (not (= (bvxor (bvand (bvand state0 (bvadd (bvadd #x160e4f34 u16_2) state0)) #x160e4f34) #x2a1ce984) (bvxor (bvand (bvand (bvadd (bvadd #x160e4f34 u16_2) state0) state0) #x160e4f34) #x2a1ce984))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvand state0 (bvadd (bvadd u16_3 state0) #x20f4b909)) (bvand (bvadd (bvadd #x20f4b909 u16_3) state0) state0))))
(check-sat)
(get-model)

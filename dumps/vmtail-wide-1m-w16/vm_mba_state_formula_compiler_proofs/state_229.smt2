(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvxor (bvxor (bvxor (bvxor (bvxor (bvxor state0 flags0) (bvsub #x4a304ad7 u16_3)) state0) flags0) #x4a304ad7) #x381ae5a5) (bvxor (bvsub #x4a304ad7 u16_3) #x722aaf72))))
(check-sat)
(get-model)

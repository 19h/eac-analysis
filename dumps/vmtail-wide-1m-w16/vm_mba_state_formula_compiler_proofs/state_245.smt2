(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (not (= (bvxor (bvxor state0 (bvadd u16_0 state0)) #x3a835417) (bvxor (bvxor (bvadd u16_0 state0) state0) #x3a835417))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvor (bvor (bvor state0 flags0) (bvsub u16_2 state0)) (bvadd flags0 #x68baea26)) (bvor (bvor (bvsub u16_2 state0) (bvor state0 flags0)) (bvadd flags0 #x68baea26)))))
(check-sat)
(get-model)

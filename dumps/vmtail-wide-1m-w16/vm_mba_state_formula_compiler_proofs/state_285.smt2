(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvxor (bvxor state0 (bvsub (bvadd flags0 u16_2) state0)) flags0) (bvxor (bvsub (bvadd u16_2 flags0) state0) (bvxor state0 flags0)))))
(check-sat)
(get-model)

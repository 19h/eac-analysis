(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_1 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_1) #x0000))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvor (bvor (bvor (bvor state0 (bvsub (bvadd flags0 u16_1) state0)) (bvxor (bvand flags0 u16_3) state0)) (bvsub (bvadd flags0 u16_1) state0)) (bvadd flags0 #x628c34bc)) (bvor (bvor (bvsub (bvadd u16_1 flags0) state0) (bvor (bvadd #x628c34bc flags0) state0)) (bvxor (bvand flags0 u16_3) state0)))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_3 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_3) #x0000))
(assert (not (= (bvxor (bvand state0 flags0) (bvand (bvsub u16_3 state0) (bvsub flags0 #x2c0febdf))) (bvxor (bvand (bvsub u16_3 state0) (bvadd #xd3f01421 flags0)) (bvand state0 flags0)))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvor (bvor (bvxor (bvadd state0 u16_0) flags0) (bvxor (bvand (bvadd #x2d680d90 #x69cbe1a0) (bvadd (bvsub u16_2 state0) u16_0)) flags0)) (bvadd (bvadd #x2d680d90 #x69cbe1a0) #x7ba65dc4)) (bvor (bvor (bvxor (bvand (bvsub (bvadd u16_2 u16_0) state0) #x9733ef30) flags0) (bvxor (bvadd state0 u16_0) flags0)) #x12da4cf4))))
(check-sat)
(get-model)

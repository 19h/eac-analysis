(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_0 () (_ BitVec 32))
(declare-fun u32_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_0) #x0000))
(assert (not (= (bvxor (bvxor (bvadd state0 u32_2) (bvadd (bvadd (bvadd (bvadd state0 flags0) u16_0) state0) u32_2)) (bvadd state0 flags0)) (bvxor (bvadd (bvadd (bvadd u16_0 state0) u32_2) (bvadd flags0 state0)) (bvxor (bvadd state0 u32_2) (bvadd flags0 state0))))))
(check-sat)
(get-model)

(set-logic QF_BV)
(set-option :produce-models true)
(declare-fun flags0 () (_ BitVec 32))
(declare-fun state0 () (_ BitVec 32))
(declare-fun u16_2 () (_ BitVec 32))
(assert (= ((_ extract 31 16) u16_2) #x0000))
(assert (not (= (bvor (bvor (bvor (bvand state0 flags0) #x16bae797) (bvand (bvadd u16_2 state0) flags0)) (bvsub #x16bae797 #x6683bbe1)) (bvor (bvand (bvor (bvadd u16_2 state0) state0) flags0) #xb6bfefb7))))
(check-sat)
(get-model)
